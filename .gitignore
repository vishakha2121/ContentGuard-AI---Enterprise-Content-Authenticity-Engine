# ============================================
# CONTENTGUARD AI - COMPLETE .gitignore
# ============================================

# ============================================
# PYTHON
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pye

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebooks
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pdm
.pdm.toml

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ============================================
# NODE / JAVASCRIPT
# ============================================

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# Lerna
lerna-debug.log*

# Vite
.vite/

# TypeScript
*.tsbuildinfo

# Next.js
.next/
out/

# Nuxt.js
.nuxt/
dist/

# Gatsby
.cache/
public/

# Storybook
storybook-static/

# Yarn
.yarn/
.yarnrc
.yarnrc.yml
.pnp.*
.pnp.js

# Pnpm
.pnpm-store/

# ============================================
# DATABASES
# ============================================

*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.sqlite3-journal

# Database backups
*.dump
*.bak
*.backup
*.sql.bak

# ============================================
# ENVIRONMENT FILES
# ============================================

.env
.env.local
.env.development
.env.production
.env.test
.env.staging
.env.*.local

# ============================================
# IDE / EDITOR FILES
# ============================================

# Visual Studio Code
.vscode/
*.code-workspace
.vscode-test/
.vscode/settings.json
.vscode/launch.json

# IntelliJ IDEA / PyCharm / WebStorm
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Vim
*.swp
*.swo
*~
*.un~
*.backup

# Sublime Text
*.sublime-project
*.sublime-workspace

# Emacs
*~
\#*
.\#*

# Atom
.atom/

# Brackets
brackets.json

# NetBeans
nbproject/
nbdist/

# Eclipse
.project
.classpath
.settings/
.metadata/

# ============================================
# OPERATING SYSTEM FILES
# ============================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.temp
*.log
*.cache
*.pid
*.seed
*.pid.lock
*.swp
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.directory
*.part
*.swp
*.swo
*.lock
*.pid

# ============================================
# LOGS
# ============================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ============================================
# COMPILED FILES
# ============================================

*.com
*.class
*.dll
*.exe
*.o
*.so
*.out
*.app
*.dSYM
*.dSYM.zip
*.gz
*.xz
*.zip
*.rar
*.7z

# ============================================
# TEMPORARY FILES
# ============================================

tmp/
temp/
*.tmp
*.temp
*.cache
*.cached
*.stamp

# ============================================
# PROJECT SPECIFIC
# ============================================

# Backend specific
backend/static/uploads/
backend/static/watermarks/
backend/static/temp/
backend/static/logs/
backend/migrations/versions/*.py
!backend/migrations/versions/__init__.py

# Uploaded media files
media/
uploads/
downloads/
temp_uploads/

# Model files
*.h5
*.pkl
*.pickle
*.joblib
*.model
*.pb
*.onnx
*.tflite
*.pt
*.pth
*.ckpt
*.weights
*.hdf5

# Backup files
*.backup
*.old
*.orig

# ============================================
# SECURITY FILES
# ============================================

*.pem
*.key
*.crt
*.csr
*.pub
*.private
*.secret
*.token
*.cert
*.p12
*.pfx

# ============================================
# TEST FILES
# ============================================

test_results/
test-reports/
.junit/
.coverage
.nyc_output
.ng
.ngrok

# ============================================
# BUILD / DIST FILES
# ============================================

/build
/dist
/out
/.next
/.nuxt
/.cache
/coverage

# ============================================
# CONFIGURATION FILES (with sensitive data)
# ============================================

config.local.*
*.local.config
*.local.json
*.local.yaml
*.local.yml
*.local.toml
*.local.ini
*.local.env

# ============================================
# PACKAGE MANAGER LOCKS
# ============================================

# NPM
package-lock.json

# Yarn
yarn.lock

# PNPM
pnpm-lock.yaml

# ============================================
# DOCKER
# ============================================

*.pid
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml
.dockerignore

# ============================================
# KUBERNETES
# ============================================

*.secret.yaml
*.secret.yml
secrets.yaml
secrets.yml
kubeconfig
*.kubeconfig

# ============================================
# CI/CD
# ============================================

.github/.cache
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# ============================================
# MISC
# ============================================

# Don't include .env files in version control
.env*
!.env.example

# Don't include API keys, tokens, or secrets
*.secret
*.key
*.pem
*.crt
*.csr

# Don't include database files
*.db
*.sqlite

# Don't include OS junk files
.DS_Store
Thumbs.db
Desktop.ini

# Don't include editor files
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# ADDITIONAL EXCLUSIONS
# ============================================

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage/
coverage.xml
*.cover

# Profiling data
*.prof
*.gcda
*.gcno
*.gcov

# Debug logs
debug.log
*.log

# Docs build
docs/_build/
docs/build/

# Jupyter notebooks with sensitive data
*.ipynb
!notebooks/*.ipynb

# Azure Functions
local.settings.json

# ============================================
# EXCEPTIONS (Files to TRACK)
# ============================================

# Track example env files
!.env.example
!.env.sample

# Track sample data
!**/sample_data/
!**/sample.*
!**/*.sample.*

# Track empty directories
!**/.gitkeep

