# DOCKER
# ============================================

*.pid
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml
.dockerignore

# ============================================
# KUBERNETES
# ============================================

*.secret.yaml
*.secret.yml
secrets.yaml
secrets.yml
kubeconfig
*.kubeconfig

# ============================================
# CI/CD
# ============================================

.github/.cache
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# ============================================
# MISC
# ============================================

# Don't include .env files in version control
.env*
!.env.example

# Don't include API keys, tokens, or secrets
*.secret
*.key
*.pem
*.crt
*.csr

# Don't include database files
*.db
*.sqlite

# Don't include OS junk files
.DS_Store
Thumbs.db
Desktop.ini

# Don't include editor files
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# ADDITIONAL EXCLUSIONS
# ============================================

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage/
coverage.xml
*.cover

# Profiling data
*.prof
*.gcda
*.gcno
*.gcov

# Debug logs
debug.log
*.log

# Docs build
docs/_build/
docs/build/

# Jupyter notebooks with sensitive data
*.ipynb
!notebooks/*.ipynb

# Azure Functions
local.settings.json

# ============================================
# EXCEPTIONS (Files to TRACK)
# ============================================

# Track example env files
!.env.example
!.env.sample

# Track sample data
!**/sample_data/
!**/sample.*
!**/*.sample.*

# Track empty directories
!**/.gitkeep
# ============================================
# CONTENTGUARD AI - COMPLETE .gitignore
# ============================================

